cc = arm-none-eabi-g++
ar = arm-none-eabi-ar
cflags = -std=c++20 -fwrapv -fno-strict-aliasing -fno-rtti -fno-exceptions -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard -mthumb -ffunction-sections -fdata-sections -fstack-usage -nostdlib -g3 -O0
wflags = -Wall -Wextra -Werror=return-type
ldflags = -fuse-ld=lld -g3
rule compile
  command = $cc $cflags $wflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
rule archive
  command = $ar rcs $out $in
rule link
  command = $cc -o $out $in $ldflags
build main.cpp.o: compile main.cpp
build base.cpp.o: compile base.cpp
build ft_sched.cpp.o: compile ft_sched.cpp
build ft_sched.a: archive main.cpp.o base.cpp.o ft_sched.cpp.o

