cc = clang++
cflags = -std=c++20 -fwrapv -fno-strict-aliasing -fno-rtti -fno-exceptions -D_CRT_SECURE_NO_WARNINGS -g -O0
wflags = -Wall -Wextra -Werror=return-type
ldflags = -g
rule compile
  command = $cc $cflags $wflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
rule archive
  command = $ar rcs $out $in
rule link
  command = $cc -o $out $in $ldflags
build main.cpp.o: compile main.cpp
build base.cpp.o: compile base.cpp
build ft_sched.cpp.o: compile ft_sched.cpp
build platform_windows.cpp.o: compile platform_windows.cpp
build ft_sched.exe: link main.cpp.o base.cpp.o ft_sched.cpp.o platform_windows.cpp.o

